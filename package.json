{
    "name": "fail-on-console",
    "version": "1.5.1",
    "description": "Fail Vitest, Jest or node:test tests when unexpected console logs, warnings or errors occur.",
    "keywords": [
        "jest",
        "vitest",
        "node:test",
        "console",
        "testing"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/benquarmby/fail-on-console"
    },
    "license": "MIT",
    "imports": {
        "#runner-adapter": {
            "node-test": "./src/__runner-adapters__/node.ts",
            "jest": "./src/__runner-adapters__/jest.ts",
            "default": "./src/__runner-adapters__/vitest.ts"
        },
        "#fail-on-console": {
            "node-test": "./lib/index.js",
            "default": "./src/index.ts"
        }
    },
    "exports": {
        ".": "./lib/index.js",
        "./package.json": "./package.json"
    },
    "main": "./lib/index.js",
    "files": [
        "./CHANGELOG.md",
        "./lib/"
    ],
    "scripts": {
        "prebuild": "tsc --noEmit",
        "build": "tsc --project tsconfig.build.json",
        "clean": "del-cli ./lib",
        "commit:check": "commitlint --from-last-tag",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "run-s test:vitest test:jest test:node",
        "test:jest": "jest",
        "test:vitest": "vitest run --coverage",
        "unused:check": "knip",
        "verify": "run-s commit:check format:check unused:check clean test",
        "test:node": "run-s build \"test:node:*\"",
        "test:node:assert": "node --test --conditions=node-test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/__tests__/assert.test.ts",
        "test:node:concurrency": "node --test --conditions=node-test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/__tests__/concurrency.test.ts",
        "test:node:core": "node --test --conditions=node-test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/__fixtures__/setup.ts src/__tests__/console.test.ts src/__tests__/core.test.ts src/__tests__/process.test.ts",
        "test:node:formatting": "node --test --conditions=node-test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/__tests__/formatting.test.ts",
        "test:node:validation": "node --test --conditions=node-test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/__tests__/validation.test.ts"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@jest/globals": "^30.5.2",
        "@types/node": "~26.6.6",
        "@vitest/coverage-v8": "^5.1.1",
        "del-cli": "^8.0.1",
        "expect": "^30.5.2",
        "jest": "^30.5.2",
        "knip": "^6.47.0",
        "npm-run-all2": "^9.1.0",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "ts-jest": "^29.4.15",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1"
    },
    "packageManager": "pnpm@12.18.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.1",
            "onFail": "download"
        }
    }
}
